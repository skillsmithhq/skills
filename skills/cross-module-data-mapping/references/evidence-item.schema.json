{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-item.schema.json",
  "title": "Evidence register item",
  "type": "object",
  "required": ["id", "class", "statement", "source", "confidence", "produced_by"],
  "properties": {
    "id": {"type": "string"},
    "class": {"type": "string", "enum": ["FACT", "CALC", "PATTERN", "HYP", "INTERP", "REC", "ASSUME", "UNKNOWN"]},
    "statement": {"type": "string"},
    "source": {"type": "object"},
    "method": {"type": "string"},
    "period": {"type": "string"},
    "confidence": {"type": "string", "enum": ["Very high", "High", "Medium", "Low", "Insufficient"]},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "produced_by": {"type": "string"}
  }
}
